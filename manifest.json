{
  "manifest_version": 3,
  "name": "表格转交",
  "version": "0.2.5",
  "key": "",
  "description": "把 Google 表格当前选中的数据无格式转交到指定表格分表。",
  "permissions": ["storage", "clipboardRead", "clipboardWrite", "identity", "alarms"],
  "host_permissions": ["https://docs.google.com/spreadsheets/*", "https://sheets.googleapis.com/*", "https://api.groq.com/*", "https://generativelanguage.googleapis.com/*"],
  "oauth2": {
    "client_id": "357885944577-1rriecqp10u98ogkqi9p1h71a25mco3o.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": {
    "default_title": "打开表格自动化控制台"
  }
}
